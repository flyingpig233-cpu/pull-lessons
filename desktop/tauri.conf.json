{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "pull-lessons",
  "version": "0.1.0",
  "identifier": "cn.hust.pulllessons",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "HUST 公选课抢课助手",
        "width": 1280,
        "height": 860,
        "minWidth": 1080,
        "minHeight": 720,
        "center": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "pull-lessons",
    "copyright": "Copyright © 2026 pull-lessons",
    "category": "Education",
    "shortDescription": "HUST 公选课抢课助手",
    "longDescription": "华中科技大学主校区公选课查询、监听与自动抢课工具。",
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": ["SimpChinese"],
        "displayLanguageSelector": false
      }
    }
  }
}
